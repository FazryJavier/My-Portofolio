---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const readingTime = (body = '') => Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog — Fazry Javier Nugraha" description="Notes and articles on fullstack development, AI agents, and building things for the web.">
  <Navbar />
  <main class="scroll-mt-24 pt-32">
    <div class="container-page pb-24 md:pb-32">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-fg sm:text-5xl">Writing &amp; notes</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Thoughts on fullstack development, AI agents, and lessons from building real projects.
      </p>

      {
        posts.length === 0 ? (
          <p class="mt-16 text-muted">No articles yet — check back soon.</p>
        ) : (
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-panel transition-colors hover:border-accent/50"
              >
                <div class="relative aspect-16/10 overflow-hidden">
                  {post.data.cover ? (
                    <Image
                      src={post.data.cover}
                      alt={post.data.title}
                      width={800}
                      height={500}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                  ) : (
                    <div
                      class="grid h-full w-full place-items-center"
                      style="background: linear-gradient(135deg, var(--accent), var(--accent-2))"
                    >
                      <Icon name="lucide:pen-line" width={34} height={34} class="text-white/90" />
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-center gap-2 font-mono text-xs text-muted">
                    <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                    <span>·</span>
                    <span>{readingTime(post.body)} min read</span>
                  </div>
                  <h2 class="mt-2 font-display text-lg font-semibold text-fg group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 line-clamp-2 text-sm text-muted">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-1.5">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <li class="rounded-md border border-border bg-panel-2 px-2 py-0.5 text-xs font-medium text-muted">
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
