---
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';

// FormSubmit alias keeps the real email out of the form endpoint markup.
const FORMSUBMIT_ID = '5397ef86d091e5ca5fb2f04984213132';
const inputClass =
  'h-11 w-full rounded-lg border border-border bg-panel-subtle px-3.5 text-sm text-fg placeholder:text-muted/70 outline-none transition-[border-color,box-shadow,background-color] duration-100 focus:border-primary focus:bg-panel focus:ring-4 focus:ring-primary/15';
---

<section id="contact" class="border-t border-border scroll-mt-20">
  <div class="container-page py-20 md:py-32">
    <div class="max-w-2xl">
      <p class="eyebrow">Let's connect</p>
      <h2 class="text-balance mt-4 font-display text-3xl font-semibold leading-tight text-fg sm:text-5xl">
        Have a project in mind?
      </h2>
      <p class="mt-5 text-lg leading-8 text-muted">
        Tell me what you're working on, where it is today, and what a good outcome looks like. I’ll get back to you as soon as I can.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(240px,0.7fr)_minmax(0,1.3fr)] lg:gap-16" data-reveal>
      <div>
        <div class="rounded-2xl border border-border bg-panel-subtle p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Prefer a direct line?</p>
          <div class="mt-5 space-y-4">
            <a href={`mailto:${profile.email}`} class="group flex items-center gap-3 text-sm font-medium text-fg transition-colors duration-100 hover:text-primary">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-panel text-primary shadow-soft">
                <Icon name="lucide:mail" width={18} height={18} aria-hidden="true" />
              </span>
              <span class="break-all">{profile.email}</span>
            </a>
            <a
              href={profile.social.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 text-sm font-medium text-fg transition-colors duration-100 hover:text-primary"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-panel text-primary shadow-soft">
                <Icon name="simple-icons:whatsapp" width={18} height={18} aria-hidden="true" />
              </span>
              {profile.phone} <span class="text-muted">(WhatsApp)</span>
            </a>
            <p class="flex items-center gap-3 text-sm font-medium text-fg">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-panel text-primary shadow-soft">
                <Icon name="lucide:map-pin" width={18} height={18} aria-hidden="true" />
              </span>
              {profile.location}
            </p>
          </div>
        </div>
        <p class="mt-6 text-sm leading-6 text-muted">You can also find me sharing work, experiments, and occasional notes online.</p>
        <SocialIcons class="mt-5" size={18} />
      </div>

      <form
        id="contact-form"
        data-endpoint={`https://formsubmit.co/ajax/${FORMSUBMIT_ID}`}
        class="rounded-2xl border border-border bg-panel p-5 shadow-card sm:p-8"
      >
        <input type="hidden" name="_subject" value={`New message from portfolio — ${profile.name}`} />
        <input type="hidden" name="_template" value="box" />
        <input type="hidden" name="_captcha" value="false" />

        <div class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label for="website">Leave this field blank</label>
          <input id="website" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-fg">Name</label>
            <input id="name" name="name" type="text" required minlength="2" autocomplete="name" placeholder="Your name" class={`${inputClass} h-11`} />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-fg">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class={`${inputClass} h-11`} />
          </div>
        </div>

        <div class="mt-5">
          <label for="message" class="mb-2 block text-sm font-medium text-fg">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            minlength="10"
            placeholder="Tell me about your project..."
            class={`${inputClass} h-auto min-h-36 resize-y py-3.5`}
          ></textarea>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            id="contact-submit"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-on-accent transition-[transform,background-color] duration-100 hover:-translate-y-0.5 hover:bg-primary-600 disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span id="submit-label">Send message</span>
            <Icon id="submit-spinner" name="lucide:loader-circle" width={17} height={17} class="hidden animate-spin" aria-hidden="true" />
          </button>
          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const submitButton = document.getElementById('contact-submit');
  const submitLabel = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');
  const endpoint = form?.dataset.endpoint;

  const setLoading = (loading: boolean) => {
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = loading;
    spinner?.classList.toggle('hidden', !loading);
    if (submitLabel) submitLabel.textContent = loading ? 'Sending...' : 'Send message';
  };

  const setStatus = (message: string, success: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('text-success', success);
    status.classList.toggle('text-error', !success);
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !endpoint) return;

    setLoading(true);
    setStatus('', true);

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success === 'true' || result.success === true) {
        setStatus('Message sent. Thanks — I’ll get back to you soon.', true);
        form.reset();
      } else {
        setStatus('Could not send right now. Please reach me on WhatsApp instead.', false);
      }
    } catch {
      setStatus('Network error. Please reach me on WhatsApp instead.', false);
    } finally {
      setLoading(false);
    }
  });
</script>
