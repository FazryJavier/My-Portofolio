---
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';

// Set PUBLIC_WEB3FORMS_KEY in .env (get a free key at https://web3forms.com).
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contact" class="scroll-mt-24 bg-surface">
  <div class="container-page py-20 md:py-28">
    <div class="flex flex-col gap-12 md:flex-row" data-reveal>
      <!-- Left: info -->
      <div class="w-full md:w-[38%]">
        <h2 class="text-4xl font-extrabold text-ink sm:text-5xl">Contact Me</h2>
        <p class="mt-5 flex items-center gap-3 text-ink">
          <Icon name="lucide:mail" width={20} height={20} class="text-secondary" />
          <a href={`mailto:${profile.email}`} class="hover:text-secondary">{profile.email}</a>
        </p>
        <p class="mt-3 flex items-center gap-3 text-ink">
          <Icon name="lucide:phone" width={20} height={20} class="text-secondary" />
          <a href={`tel:${profile.phone}`} class="hover:text-secondary">{profile.phone}</a>
        </p>
        <p class="mt-3 flex items-center gap-3 text-ink">
          <Icon name="lucide:map-pin" width={20} height={20} class="text-secondary" />
          {profile.location}
        </p>
        <SocialIcons class="mt-8" size={20} />
      </div>

      <!-- Right: form -->
      <div class="w-full md:w-[62%]">
        <form id="contact-form" class="space-y-4">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value={`New message from portfolio — ${profile.name}`} />
          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="mb-1 block text-sm font-medium text-ink">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              minlength="2"
              placeholder="Your Name"
              class="w-full rounded-lg border border-black/10 bg-white px-4 py-3 text-ink outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/30"
            />
          </div>

          <div>
            <label for="email" class="mb-1 block text-sm font-medium text-ink">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-lg border border-black/10 bg-white px-4 py-3 text-ink outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/30"
            />
          </div>

          <div>
            <label for="message" class="mb-1 block text-sm font-medium text-ink">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              minlength="10"
              placeholder="Your Message"
              class="w-full rounded-lg border border-black/10 bg-white px-4 py-3 text-ink outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/30"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-secondary px-8 py-3 font-medium text-white transition-colors hover:bg-primary hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span id="submit-label">Submit</span>
            <Icon id="submit-spinner" name="lucide:loader-circle" width={18} height={18} class="hidden animate-spin" />
          </button>

          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ whatsapp: profile.social.whatsapp }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const btn = document.getElementById('contact-submit');
  const label = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');

  const setLoading = (on) => {
    btn.disabled = on;
    spinner.classList.toggle('hidden', !on);
    label.textContent = on ? 'Sending…' : 'Submit';
  };
  const setStatus = (msg, ok) => {
    status.textContent = msg;
    status.style.color = ok ? '#1e9fab' : '#b54769';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    if (!data.get('access_key')) {
      setStatus('Form belum dikonfigurasi. Hubungi saya via WhatsApp untuk sementara.', false);
      window.open(whatsapp, '_blank');
      return;
    }

    setLoading(true);
    setStatus('', true);
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (json.success) {
        setStatus('Pesan terkirim ✅ Terima kasih, saya akan segera membalas.', true);
        form.reset();
      } else {
        setStatus('Gagal mengirim. Coba lagi atau hubungi via WhatsApp.', false);
      }
    } catch {
      setStatus('Terjadi kesalahan jaringan. Coba lagi atau hubungi via WhatsApp.', false);
    } finally {
      setLoading(false);
    }
  });
</script>
