---
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';

// FormSubmit alias for fazryjavier125@gmail.com (keeps the real email out of the HTML).
// Activate once by submitting the form and clicking "Activate Form" in the email.
const FORMSUBMIT_ID = '5397ef86d091e5ca5fb2f04984213132';

const inputClass =
  'w-full rounded-xl border border-border bg-panel-2 px-4 py-3 text-fg placeholder:text-muted/70 outline-none transition-colors focus:border-accent focus:ring-2 focus:ring-accent/25';
---

<section id="contact" class="scroll-mt-24">
  <div class="container-page py-24 md:py-32">
    <p class="eyebrow">Contact</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-fg sm:text-5xl">Let's work together</h2>

    <div class="mt-12 flex flex-col gap-10 md:flex-row" data-reveal>
      <!-- Left: info -->
      <div class="w-full md:w-[38%]">
        <p class="text-muted">
          Have a project, role, or just want to say hi? Send a message and I'll reply as soon as I can.
        </p>
        <div class="mt-8 space-y-4">
          <a href={`mailto:${profile.email}`} class="flex items-center gap-3 text-fg hover:text-accent">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-border">
              <Icon name="lucide:mail" width={18} height={18} class="text-accent" />
            </span>
            {profile.email}
          </a>
          <a
            href={profile.social.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-fg hover:text-accent"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-border">
              <Icon name="simple-icons:whatsapp" width={18} height={18} class="text-accent" />
            </span>
            {profile.phone} (WhatsApp)
          </a>
          <p class="flex items-center gap-3 text-fg">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-border">
              <Icon name="lucide:map-pin" width={18} height={18} class="text-accent" />
            </span>
            {profile.location}
          </p>
        </div>
        <SocialIcons class="mt-8" size={20} />
      </div>

      <!-- Right: form (delivers straight to email via FormSubmit) -->
      <div class="w-full md:w-[62%]">
        <form id="contact-form" class="space-y-4 rounded-3xl border border-border bg-panel p-6 shadow-card sm:p-8">
          <input type="hidden" name="_subject" value={`New message from portfolio — ${profile.name}`} />
          <input type="hidden" name="_template" value="box" />
          <input type="hidden" name="_captcha" value="false" />
          <!-- Honeypot -->
          <input type="text" name="_honey" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-fg">Name</label>
              <input id="name" name="name" type="text" required minlength="2" placeholder="Your name" class={inputClass} />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-fg">Email</label>
              <input id="email" name="email" type="email" required placeholder="you@example.com" class={inputClass} />
            </div>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-fg">Message</label>
            <textarea id="message" name="message" rows="6" required minlength="10" placeholder="Tell me about your project…" class={inputClass}></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-8 py-3 font-semibold text-on-accent transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span id="submit-label">Send message</span>
            <Icon id="submit-spinner" name="lucide:loader-circle" width={18} height={18} class="hidden animate-spin" />
          </button>

          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ endpoint: `https://formsubmit.co/ajax/${FORMSUBMIT_ID}`, whatsapp: profile.social.whatsapp }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const btn = document.getElementById('contact-submit');
  const label = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');

  const setLoading = (on) => {
    btn.disabled = on;
    spinner.classList.toggle('hidden', !on);
    label.textContent = on ? 'Sending…' : 'Send message';
  };
  const setStatus = (msg, ok) => {
    status.textContent = msg;
    status.style.color = ok ? 'var(--accent-2)' : '#f87171';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(true);
    setStatus('', true);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const json = await res.json();
      if (json.success === 'true' || json.success === true) {
        setStatus('Message sent ✅ Thanks — I will get back to you soon.', true);
        form.reset();
      } else {
        setStatus('Could not send right now. Please reach me on WhatsApp instead.', false);
      }
    } catch {
      setStatus('Network error. Please reach me on WhatsApp instead.', false);
    } finally {
      setLoading(false);
    }
  });
</script>
