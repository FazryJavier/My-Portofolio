---
import { Icon } from 'astro-icon/components';
import { skillGroups } from '../data/skills';
---

<section id="skills" class="border-y border-border bg-panel-subtle scroll-mt-20">
  <div class="container-page py-20 md:py-32">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">The toolkit</p>
        <h2 class="text-balance mt-4 font-display text-3xl font-semibold leading-tight text-fg sm:text-5xl">
          Practical tools for ambitious ideas.
        </h2>
      </div>
      <p class="max-w-md text-base leading-7 text-muted lg:pb-1">
        A flexible stack helps me move from a first API contract to a calm, responsive interface without losing the plot.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-3" data-reveal>
      {
        skillGroups.map((group, index) => (
          <div class="group rounded-2xl border border-border bg-panel p-6 shadow-soft transition-[transform,border-color,box-shadow] duration-150 hover:-translate-y-1 hover:border-primary-100 hover:shadow-card">
            <div class="flex items-center justify-between">
              <span class="grid size-10 place-items-center rounded-lg bg-soft-primary text-primary">
                <Icon
                  name={index === 0 ? 'lucide:braces' : index === 1 ? 'lucide:blocks' : 'lucide:database'
                  }
                  width={19}
                  height={19}
                  aria-hidden="true"
                />
              </span>
              <span class="font-mono text-xs font-semibold text-muted">0{index + 1}</span>
            </div>
            <h3 class="mt-6 font-display text-lg font-semibold text-fg">{group.title}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-subtle px-3 py-1.5 text-xs font-medium text-fg transition-[border-color,color,background-color] duration-100 hover:border-primary hover:bg-soft-primary hover:text-primary">
                  {skill.icon && <Icon name={skill.icon} width={15} height={15} aria-hidden="true" />}
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
      <span class="font-semibold text-fg">Also exploring</span>
      <span class="size-1 rounded-full bg-secondary" aria-hidden="true"></span>
      AI agents
      <span class="size-1 rounded-full bg-secondary" aria-hidden="true"></span>
      System design
      <span class="size-1 rounded-full bg-secondary" aria-hidden="true"></span>
      Better developer experiences
    </div>
  </div>
</section>
