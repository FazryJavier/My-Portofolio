---
import { Icon } from 'astro-icon/components';
import { skillGroups } from '../data/skills';
---

<section id="skills" class="scroll-mt-24">
  <div class="container-page py-24 md:py-32">
    <p class="eyebrow">Skills</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-fg sm:text-5xl">Tools I work with</h2>
    <p class="mt-4 max-w-2xl text-muted">
      The stack I reach for to build and ship fullstack web applications.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        skillGroups.map((group) => (
          <div class="group rounded-2xl border border-border bg-panel p-6 transition-colors hover:border-accent/50">
            <h3 class="font-display text-lg font-semibold text-fg">{group.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {group.items.map((skill) => (
                <li class="inline-flex items-center gap-2 rounded-lg border border-border bg-panel-2 px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent">
                  {skill.icon && <Icon name={skill.icon} width={18} height={18} />}
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
