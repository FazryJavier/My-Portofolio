---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import { education, experience, certificates, organizations, type TimelineItem } from '../data/about';
import aboutImg from '../assets/about.jpg';

const tabs: { id: string; label: string; items: TimelineItem[] }[] = [
  { id: 'experience', label: 'Experience', items: experience },
  { id: 'education', label: 'Education', items: education },
  { id: 'certificate', label: 'Certificate', items: certificates },
  { id: 'organization', label: 'Organization', items: organizations },
];
const EXP_VISIBLE = 4;

const facts = [
  { icon: 'lucide:briefcase', label: 'Fullstack Engineer @ GITS Indonesia' },
  { icon: 'lucide:map-pin', label: profile.location },
  { icon: 'lucide:graduation-cap', label: 'Informatics, ITENAS Bandung' },
  { icon: 'lucide:sparkles', label: 'Exploring AI Agents' },
];
---

<section id="about" class="scroll-mt-24">
  <div class="container-page py-24 md:py-32">
    <p class="eyebrow">About</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-fg sm:text-5xl">A bit about me</h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)]" data-reveal>
      <!-- Left: photo + quick facts -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="relative overflow-hidden rounded-3xl border border-border">
          <Image
            src={aboutImg}
            alt={`Photo of ${profile.name}`}
            width={520}
            height={600}
            class="w-full object-cover"
          />
          <div
            class="absolute inset-x-0 bottom-0 flex items-center gap-2 bg-linear-to-t from-black/70 to-transparent p-4 text-sm text-white"
          >
            <span class="size-2 rounded-full bg-accent-2"></span>
            Currently building at GITS Indonesia
          </div>
        </div>

        <ul class="mt-5 grid gap-3">
          {
            facts.map((f) => (
              <li class="flex items-center gap-3 text-sm text-muted">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-border text-accent">
                  <Icon name={f.icon} width={16} height={16} />
                </span>
                {f.label}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: bio + timeline -->
      <div>
        <p class="text-lg leading-relaxed text-muted">{profile.aboutBio}</p>

        <!-- Tabs -->
        <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="About sections">
          {
            tabs.map((t, i) => (
              <button
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={t.id}
                class="tab-btn rounded-full border border-border px-4 py-1.5 text-sm font-medium text-muted transition-colors aria-selected:border-accent aria-selected:bg-accent/10 aria-selected:text-accent"
              >
                {t.label}
              </button>
            ))
          }
        </div>

        <!-- Panels: vertical timeline -->
        <div class="mt-8 max-h-[440px] overflow-y-auto pr-2">
          {
            tabs.map((t, i) => (
              <div
                role="tabpanel"
                id={`panel-${t.id}`}
                aria-labelledby={`tab-${t.id}`}
                data-panel={t.id}
                class={i === 0 ? '' : 'hidden'}
              >
                <ul>
                  {t.items.map((item, idx) => {
                    const hidden = t.id === 'experience' && idx >= EXP_VISIBLE;
                    const isLast = idx === t.items.length - 1;
                    return (
                      <li
                        class="timeline-item flex gap-4"
                        data-exp={hidden ? 'hidden' : null}
                        hidden={hidden}
                      >
                        <div class="flex flex-col items-center pt-1.5">
                          <span class="size-3 shrink-0 rounded-full border-2 border-accent bg-bg" />
                          {!isLast && <span class="mt-1 w-px flex-1 bg-border" />}
                        </div>
                        <div class="pb-7">
                          <p class="font-mono text-xs tracking-wider text-accent">{item.period}</p>
                          <p class="mt-1 font-semibold text-fg">{item.title}</p>
                          {item.subtitle && <p class="text-sm text-muted">{item.subtitle}</p>}
                          {item.details && (
                            <ul class="mt-2 list-disc space-y-0.5 pl-5 text-sm text-muted">
                              {item.details.map((d) => (
                                <li>{d}</li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
                {t.id === 'experience' && t.items.length > EXP_VISIBLE && (
                  <button
                    id="exp-load-more"
                    class="ml-7 rounded-lg border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-panel-2"
                  >
                    Show earlier roles
                  </button>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab;
      tabBtns.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== id));
    });
  });

  const loadMore = document.getElementById('exp-load-more');
  loadMore?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('[data-exp="hidden"]').forEach((li) => {
      li.hidden = false;
      li.removeAttribute('data-exp');
    });
    loadMore.remove();
  });
</script>
