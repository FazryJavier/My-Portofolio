---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import { education, experience, certificates, organizations, type TimelineItem } from '../data/about';
import aboutImg from '../assets/about.jpg';

const tabs: { id: string; label: string; items: TimelineItem[] }[] = [
  { id: 'experience', label: 'Experience', items: experience },
  { id: 'education', label: 'Education', items: education },
  { id: 'certificate', label: 'Certificates', items: certificates },
  { id: 'organization', label: 'Organizations', items: organizations },
];

const EXP_VISIBLE = 4;

const facts = [
  { icon: 'lucide:briefcase-business', label: 'Fullstack engineer @ GITS Indonesia' },
  { icon: 'lucide:map-pin', label: profile.location },
  { icon: 'lucide:graduation-cap', label: 'Informatics graduate, ITENAS' },
  { icon: 'lucide:sparkles', label: 'Exploring AI agents' },
];

const workingNotes = [
  { title: 'Start with the workflow', detail: 'Understand the people, content, and decisions behind the screen first.' },
  { title: 'Make the next step obvious', detail: 'Prefer predictable paths over clever interactions that need explaining.' },
  { title: 'Leave room for change', detail: 'Build systems that a team can maintain when the first version is no longer enough.' },
];
---

<section id="about" class="scroll-mt-20">
  <div class="container-page py-20 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow">A little context</p>
      <h2 class="text-balance mt-4 font-display text-3xl font-semibold leading-tight text-fg sm:text-5xl">
        The person behind the products.
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        I enjoy the space where thoughtful product decisions meet dependable engineering.
      </p>
    </div>

    <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-[minmax(280px,0.8fr)_minmax(0,1.2fr)] lg:gap-20" data-reveal>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="overflow-hidden border border-border bg-panel p-2 shadow-soft">
          <Image
            src={aboutImg}
            alt={`Photo of ${profile.name}`}
            width={560}
            height={680}
            class="aspect-[4/5] w-full object-cover object-[50%_48%]"
            loading="lazy"
          />
        </div>

        <ul class="mt-6 grid gap-3">
          {
            facts.map((fact) => (
              <li class="flex items-center gap-3 border-b border-border py-3 text-sm text-muted last:border-b-0">
                <span class="grid size-7 shrink-0 place-items-center text-primary">
                  <Icon name={fact.icon} width={16} height={16} aria-hidden="true" />
                </span>
                {fact.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="max-w-3xl text-lg leading-8 text-muted">{profile.aboutBio}</p>

        <div class="mt-10 border-y border-border">
          {
            workingNotes.map((note, index) => (
              <div class:list={['grid gap-2 py-5 sm:grid-cols-[3rem_1fr] sm:gap-4', index > 0 && 'border-t border-border']}>
                <p class="font-mono text-sm font-medium text-muted">0{index + 1}</p>
                <div>
                  <h3 class="text-sm font-semibold text-fg">{note.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-muted">{note.detail}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-12 grid grid-cols-2 gap-2 sm:grid-cols-4" role="tablist" aria-label="About sections">
            {
              tabs.map((tab, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${tab.id}`}
                  aria-controls={`panel-${tab.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  data-tab={tab.id}
                  class="tab-btn inline-flex min-h-11 items-center justify-start rounded-lg border border-transparent px-3 py-2 text-left text-sm font-medium text-muted transition-[background-color,border-color,color] duration-100 hover:bg-panel-subtle hover:text-fg aria-selected:border-primary aria-selected:bg-soft-primary aria-selected:text-primary"
                >
                  {tab.label}
                </button>
              ))
            }
        </div>

        <div class="mt-8">
          {
            tabs.map((tab, tabIndex) => (
              <div
                role="tabpanel"
                id={`panel-${tab.id}`}
                aria-labelledby={`tab-${tab.id}`}
                data-panel={tab.id}
                class={tabIndex === 0 ? '' : 'hidden'}
                tabindex="0"
              >
                <ul class="space-y-0">
                  {tab.items.map((item, index) => {
                    const hidden = tab.id === 'experience' && index >= EXP_VISIBLE;
                    const isLast = index === tab.items.length - 1;
                    return (
                      <li class="timeline-item flex gap-4" data-exp={hidden ? 'hidden' : undefined} hidden={hidden}>
                        <div class="flex flex-col items-center pt-1.5">
                          <span class="size-3 shrink-0 rounded-full border-2 border-primary bg-bg" aria-hidden="true"></span>
                          {!isLast && <span class="mt-1 w-px flex-1 bg-border" aria-hidden="true"></span>}
                        </div>
                        <div class="pb-7">
                          <p class="text-xs font-semibold tracking-wide text-primary">{item.period}</p>
                          <p class="mt-1 font-semibold text-fg">{item.title}</p>
                          {item.subtitle && <p class="mt-0.5 text-sm text-muted">{item.subtitle}</p>}
                          {item.details && (
                            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-muted">
                              {item.details.map((detail) => <li>{detail}</li>)}
                            </ul>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
                {tab.id === 'experience' && tab.items.length > EXP_VISIBLE && (
                  <button
                    type="button"
                    id="exp-load-more"
                    class="ml-7 inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium text-fg transition-[border-color,background-color,color] duration-100 hover:border-primary hover:bg-soft-primary hover:text-primary"
                  >
                    Show earlier roles
                    <Icon name="lucide:chevron-down" width={16} height={16} aria-hidden="true" />
                  </button>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('[data-panel]');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.tab;
      if (!id) return;

      tabButtons.forEach((tab) => tab.setAttribute('aria-selected', String(tab === button)));
      tabPanels.forEach((panel) => {
        const isActive = panel.dataset.panel === id;
        panel.classList.toggle('hidden', !isActive);
        panel.setAttribute('tabindex', isActive ? '0' : '-1');
      });
    });
  });

  const loadMore = document.getElementById('exp-load-more');
  loadMore?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('[data-exp="hidden"]').forEach((item) => {
      item.hidden = false;
      item.removeAttribute('data-exp');
    });
    loadMore.remove();
  });
</script>
