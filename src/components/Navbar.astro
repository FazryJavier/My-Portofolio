---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';

const links = [
  { label: 'Home', href: '/#home' },
  { label: 'About', href: '/#about' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Work', href: '/#projects' },
  { label: 'Contact', href: '/#contact' },
  { label: 'Blog', href: '/blog' },
];

const isBlog = Astro.url.pathname.startsWith('/blog');
---

<header
  id="site-header"
  class="glass fixed inset-x-0 top-0 z-50 border-b border-border/80 transition-shadow duration-150"
>
  <nav class="container-page flex h-20 items-center justify-between transition-[height] duration-150" id="site-nav">
    <a href="/#home" class="group inline-flex items-center gap-3 rounded-lg text-fg" aria-label={`${profile.name} home`}>
      <span class="grid size-9 place-items-center rounded-lg bg-primary text-sm font-bold text-white transition-transform duration-150 group-hover:-rotate-6">
        FJ
      </span>
      <span class="font-display text-lg font-semibold tracking-tight">
        {profile.shortName}<span class="text-secondary">.</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === '/blog' && isBlog ? 'page' : undefined}
              class="nav-link relative rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors duration-100 hover:bg-primary-50 hover:text-primary aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-10 place-items-center rounded-lg border border-border bg-panel text-fg transition-colors duration-100 hover:border-primary hover:bg-soft-primary hover:text-primary"
        aria-label="Switch to dark mode"
        aria-pressed="false"
      >
        <Icon name="lucide:moon" width={18} height={18} class="block dark:hidden" aria-hidden="true" />
        <Icon name="lucide:sun" width={18} height={18} class="hidden dark:block" aria-hidden="true" />
      </button>

      <a
        href={profile.cv}
        download
        class="hidden items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition-[transform,background-color] duration-100 hover:-translate-y-0.5 hover:bg-primary-600 sm:inline-flex"
      >
        <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
        Resume
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="grid size-10 place-items-center rounded-lg border border-border bg-panel text-fg transition-colors duration-100 hover:border-primary hover:bg-soft-primary hover:text-primary md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon id="nav-menu-icon" name="lucide:menu" width={21} height={21} aria-hidden="true" />
        <Icon id="nav-close-icon" name="lucide:x" width={21} height={21} class="hidden" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="container-page hidden border-t border-border/80 py-4 md:!hidden" aria-label="Mobile navigation">
    <div class="flex flex-col gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.href === '/blog' && isBlog ? 'page' : undefined}
            class="mobile-link rounded-lg px-3 py-2.5 text-sm font-medium text-muted transition-colors duration-100 hover:bg-primary-50 hover:text-primary aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      href={profile.cv}
      download
      class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-[transform,background-color] duration-100 hover:-translate-y-0.5 hover:bg-primary-600"
    >
      <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
      Download resume
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const nav = document.getElementById('site-nav');
  const navToggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const themeToggle = document.getElementById('theme-toggle');
  const menuIcon = document.getElementById('nav-menu-icon');
  const closeIcon = document.getElementById('nav-close-icon');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    navToggle?.setAttribute('aria-expanded', String(open));
    navToggle?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };

  const setThemeLabel = () => {
    const isDark = document.documentElement.classList.contains('dark');
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  };

  const onScroll = () => {
    const shrink = window.scrollY > 32;
    header?.classList.toggle('shadow-card', shrink);
    nav?.classList.toggle('h-16', shrink);
    nav?.classList.toggle('h-20', !shrink);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  setThemeLabel();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    setThemeLabel();
  });

  navToggle?.addEventListener('click', () => {
    const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
    setMenu(!isOpen);
  });

  menu?.querySelectorAll('.mobile-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  const hashLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link')).filter((link) =>
    (link.getAttribute('href') || '').includes('#')
  );
  const idOf = (link: HTMLAnchorElement) => (link.getAttribute('href') || '').split('#')[1];
  const sections = hashLinks
    .map((link) => document.getElementById(idOf(link)))
    .filter((section): section is HTMLElement => Boolean(section));

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          hashLinks.forEach((link) => link.setAttribute('aria-current', idOf(link) === entry.target.id ? 'page' : 'false'));
        });
      },
      { rootMargin: '-38% 0px -55% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
