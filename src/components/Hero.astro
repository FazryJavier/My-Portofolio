---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';
import heroImg from '../assets/hero.jpg';
---

<section id="home" class="scroll-mt-24">
  <div class="container-page flex min-h-screen flex-col-reverse items-center gap-12 py-28 md:flex-row md:justify-between">
    <!-- Text -->
    <div class="flex w-full flex-col md:w-[55%]">
      <span class="w-fit rounded-md bg-accent px-3 py-1 text-lg font-semibold text-ink">
        {profile.name}
      </span>

      <h1 class="mt-5 text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
        I'm a
        <span id="typed-role" class="text-secondary">{profile.roles[0]}</span><span
          id="typed-caret"
          class="text-secondary"
          aria-hidden="true">|</span
        >
      </h1>

      <p class="mt-5 max-w-xl text-ink-muted">{profile.heroBio}</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={profile.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-secondary px-6 py-3 font-medium text-white shadow-soft transition-colors hover:bg-primary hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
        >
          Hire Me
        </a>
        <a
          href={profile.cv}
          download
          class="inline-flex items-center gap-2 rounded-lg bg-surface-2 px-6 py-3 font-medium text-ink shadow-soft transition-colors hover:bg-secondary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
        >
          <Icon name="lucide:download" width={18} height={18} />
          Download CV
        </a>
      </div>

      <SocialIcons class="mt-8" />
    </div>

    <!-- Image -->
    <div class="flex w-full justify-center md:w-[35%]">
      <div class="animate-img-float overflow-hidden rounded-blob shadow-card">
        <Image
          src={heroImg}
          alt={`Portrait of ${profile.name}`}
          width={320}
          height={420}
          class="h-[420px] w-[320px] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script define:vars={{ roles: profile.roles }}>
  const el = document.getElementById('typed-role');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let roleIdx = 0;
    let charIdx = roles[0].length;
    let deleting = false;

    const tick = () => {
      const word = roles[roleIdx];
      charIdx += deleting ? -1 : 1;
      el.textContent = word.slice(0, charIdx);

      let delay = deleting ? 60 : 110;
      if (!deleting && charIdx === word.length) {
        delay = 1600;
        deleting = true;
      } else if (deleting && charIdx === 0) {
        deleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        delay = 350;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1600);
  }
</script>

<style>
  #typed-caret {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #typed-caret {
      animation: none;
    }
  }
</style>
