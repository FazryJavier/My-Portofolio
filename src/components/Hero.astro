---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';
import heroImg from '../assets/hero.jpg';
---

<section id="home" class="border-b border-border scroll-mt-20">
  <div class="container-page grid items-end gap-12 pb-16 pt-32 sm:pb-20 sm:pt-40 lg:grid-cols-[minmax(0,1.15fr)_minmax(340px,0.85fr)] lg:gap-24 lg:pb-24">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-muted">Fazry Javier Nugraha · Fullstack engineer</p>
      <h1 class="text-balance mt-5 font-display text-4xl font-semibold leading-[1.12] text-fg sm:text-6xl lg:text-7xl">
        Web products for teams with <span class="text-primary">real work to do.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">{profile.heroBio}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex h-12 items-center rounded-lg bg-primary px-5 text-sm font-semibold text-on-accent shadow-soft transition-[transform,background-color,box-shadow] duration-100 hover:-translate-y-0.5 hover:bg-primary-600 hover:shadow-card"
        >
          See selected work
        </a>
        <a
          href={profile.cv}
          download
          class="inline-flex h-12 items-center gap-2 rounded-lg border border-border bg-panel px-5 text-sm font-semibold text-fg transition-[transform,border-color,background-color,color] duration-100 hover:-translate-y-0.5 hover:border-primary hover:bg-soft-primary hover:text-primary"
        >
          <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
          Download CV
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <span class="text-sm text-muted">Find me on</span>
        <SocialIcons size={17} />
      </div>
    </div>

    <figure class="w-full max-w-[460px] justify-self-center lg:justify-self-end">
      <div class="overflow-hidden border border-border bg-panel p-2 shadow-soft">
        <Image
          src={heroImg}
          alt={`Portrait of ${profile.name}`}
          width={640}
          height={800}
          class="aspect-[4/5] w-full object-cover object-[50%_42%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="mt-4 grid gap-4 border-t border-border pt-4 text-sm sm:grid-cols-2">
        <div>
          <p class="text-muted">Based in</p>
          <p class="mt-1 font-medium text-fg">{profile.location}</p>
        </div>
        <div>
          <p class="text-muted">Current work</p>
          <p class="mt-1 font-medium text-fg">Fullstack engineering at GITS</p>
        </div>
      </figcaption>
    </figure>
  </div>
</section>
