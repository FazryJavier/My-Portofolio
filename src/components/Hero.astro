---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';
import heroImg from '../assets/hero.jpg';

const stats = [
  { value: '6+', label: 'projects shipped' },
  { value: '3', label: 'core disciplines' },
  { value: '2026', label: 'current chapter' },
];
---

<section id="home" data-roles={JSON.stringify(profile.roles)} class="relative isolate overflow-hidden border-b border-border/70 scroll-mt-20">
  <div class="hero-grid pointer-events-none absolute inset-x-0 top-0 -z-10 h-[720px] opacity-80" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -right-40 top-24 -z-10 size-[34rem] rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(circle, var(--glow), transparent 68%)"
    aria-hidden="true"
  ></div>

  <div class="container-page grid items-center gap-12 pb-12 pt-28 sm:gap-16 sm:pb-16 sm:pt-36 lg:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)] lg:gap-20 lg:pb-20 lg:pt-40">
    <div class="min-w-0">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary-100 bg-soft-primary px-3 py-1.5 text-xs font-medium text-primary">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-success"></span>
        </span>
        Available for meaningful work
      </div>

      <p class="eyebrow mt-8">Fullstack engineer · Bandung, Indonesia</p>
      <h1 class="text-balance mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.12] text-fg sm:text-6xl lg:text-7xl">
        Building useful products <span class="text-primary">from sketch to ship.</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
        I'm <span class="font-semibold text-fg">{profile.name}</span>, a
        <span id="typed-role" class="font-semibold text-primary">{profile.roles[0]}</span>
        <span id="typed-caret" class="font-normal text-secondary" aria-hidden="true">|</span>
        who cares about the details between a reliable system and a delightful interface.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex h-12 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-on-accent shadow-soft transition-[transform,background-color,box-shadow] duration-100 hover:-translate-y-0.5 hover:bg-primary-600 hover:shadow-card"
        >
          Explore my work
          <Icon name="lucide:arrow-up-right" width={17} height={17} aria-hidden="true" />
        </a>
        <a
          href={profile.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center gap-2 rounded-lg border border-border bg-panel px-5 text-sm font-semibold text-fg transition-[transform,border-color,background-color,color] duration-100 hover:-translate-y-0.5 hover:border-primary hover:bg-soft-primary hover:text-primary"
        >
          Let's talk
          <Icon name="simple-icons:whatsapp" width={16} height={16} aria-hidden="true" />
        </a>
        <a
          href={profile.cv}
          download
          class="inline-flex h-12 items-center gap-2 rounded-lg px-3 text-sm font-medium text-muted transition-colors duration-100 hover:text-primary"
        >
          <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
          Download CV
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <SocialIcons size={17} />
        <span class="hidden h-6 w-px bg-border sm:block" aria-hidden="true"></span>
        <a href="#about" class="inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors duration-100 hover:text-primary">
          Scroll to explore
          <Icon name="lucide:arrow-down" width={16} height={16} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="relative mx-auto min-w-0 w-full max-w-[460px] lg:justify-self-end">
      <div class="absolute -inset-3 rounded-[2rem] border border-primary-100 bg-soft-primary/60 sm:-inset-5" aria-hidden="true"></div>
      <div class="relative z-10 mb-4 ml-auto hidden w-fit max-w-full items-center gap-2 rounded-lg border border-border bg-panel px-3 py-2.5 text-xs font-medium text-fg shadow-card sm:flex sm:px-4 sm:py-3">
        <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
        Currently building at GITS Indonesia
      </div>

      <div class="relative animate-float overflow-hidden rounded-[2rem] border border-border bg-panel p-2 shadow-card">
        <Image
          src={heroImg}
          alt={`Portrait of ${profile.name}`}
          width={640}
          height={800}
          class="aspect-[4/5] w-full rounded-[1.5rem] object-cover object-[50%_42%]"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-x-4 bottom-4 rounded-xl border border-white/30 bg-gray-900/75 p-3 text-on-accent backdrop-blur-md sm:inset-x-6 sm:bottom-6 sm:p-4">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-xs font-medium text-on-accent/70">Current focus</p>
              <p class="mt-1 text-xs font-semibold sm:text-sm">AI-assisted engineering</p>
            </div>
            <Icon name="lucide:sparkles" width={20} height={20} class="text-secondary" aria-hidden="true" />
          </div>
        </div>
      </div>

      <div class="relative z-10 mx-auto mt-4 w-full max-w-[20rem] rounded-xl border border-border bg-panel p-4 shadow-card sm:ml-auto sm:max-w-xs">
        <div class="flex items-center gap-2 text-xs font-medium text-muted">
          <span class="size-2 rounded-full bg-secondary" aria-hidden="true"></span>
          Stack I reach for
        </div>
        <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-fg">
          <span class="rounded-full bg-soft-primary px-2.5 py-1 text-primary">TypeScript</span>
          <span class="rounded-full bg-soft-secondary px-2.5 py-1 text-secondary">Laravel</span>
          <span class="rounded-full bg-panel-subtle px-2.5 py-1 text-muted">Astro</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container-page pb-8 sm:pb-10 lg:pb-14">
    <dl class="grid grid-cols-1 gap-4 border-t border-border pt-6 sm:grid-cols-3 sm:gap-0">
      {
        stats.map((stat, index) => (
          <div class={`flex items-baseline gap-3 ${index > 0 ? 'border-border sm:border-l sm:pl-6' : ''}`}>
            <dt class="order-2 text-sm text-muted">{stat.label}</dt>
            <dd class="font-display text-2xl font-semibold text-fg">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const roleEl = document.getElementById('typed-role');
  const caretEl = document.getElementById('typed-caret');
  const roleData = document.getElementById('home')?.dataset.roles;
  const roles: string[] = roleData ? JSON.parse(roleData) : [];

  if (roleEl && caretEl && roles.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let roleIndex = 0;
    let characterIndex = roles[0].length;
    let deleting = false;

    const tick = () => {
      const role = roles[roleIndex];
      characterIndex += deleting ? -1 : 1;
      roleEl.textContent = role.slice(0, characterIndex);

      let delay = deleting ? 45 : 90;
      if (!deleting && characterIndex === role.length) {
        deleting = true;
        delay = 1700;
      } else if (deleting && characterIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        delay = 280;
      }
      window.setTimeout(tick, delay);
    };

    window.setTimeout(tick, 1700);
  }
</script>

<style>
  #typed-caret {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #typed-caret {
      animation: none;
    }
  }
</style>
