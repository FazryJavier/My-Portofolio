---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, description, cover, url, repo, tags, category, year } = project.data;
const primaryLink = url ?? repo;
const categoryLabels = {
  web: 'Web product',
  cms: 'CMS platform',
  iot: 'IoT experiment',
  ml: 'Machine learning',
} as const;
---

<article
  class:list={[
    'group flex min-w-0 h-full flex-col overflow-hidden rounded-2xl border border-border bg-panel shadow-soft transition-[transform,border-color,box-shadow] duration-150 hover:-translate-y-1 hover:border-primary-100 hover:shadow-card',
    featured ? 'lg:col-span-6' : 'lg:col-span-4',
  ]}
>
  <div class:list={['relative overflow-hidden bg-panel-subtle', featured ? 'aspect-[16/9]' : 'aspect-[16/10]']}>
    <Image
      src={cover}
      alt={`${title} project preview`}
      width={1000}
      height={620}
      class="h-full w-full object-cover transition-transform duration-150 group-hover:scale-[1.03]"
      loading="lazy"
    />
    <div class="absolute inset-x-4 top-4 flex items-center justify-between gap-3">
      <span class="rounded-full bg-panel/95 px-3 py-1 text-xs font-semibold text-fg shadow-soft backdrop-blur-sm">
        {categoryLabels[category]}
      </span>
      {year && <span class="rounded-full bg-gray-900/75 px-3 py-1 text-xs font-medium text-on-accent backdrop-blur-sm">{year}</span>}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-xl font-semibold leading-snug text-fg">
        {primaryLink ? (
          <a href={primaryLink} target="_blank" rel="noopener noreferrer" class="transition-colors duration-100 hover:text-primary">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
      {featured && (
        <span class="shrink-0 rounded-full bg-soft-secondary px-2.5 py-1 text-[0.6875rem] font-semibold text-secondary">
          Featured
        </span>
      )}
    </div>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted">{description}</p>

    <ul class="mt-5 flex flex-wrap gap-2">
      {tags.slice(0, featured ? 5 : 4).map((tag) => (
        <li class="rounded-full border border-border bg-panel-subtle px-2.5 py-1 text-xs font-medium text-muted">{tag}</li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-border pt-4 text-sm font-semibold">
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-primary transition-colors duration-100 hover:text-primary-700">
          View live
          <Icon name="lucide:arrow-up-right" width={15} height={15} aria-hidden="true" />
        </a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-muted transition-colors duration-100 hover:text-primary">
          <Icon name="simple-icons:github" width={15} height={15} aria-hidden="true" />
          Source code
        </a>
      )}
      {!url && !repo && <span class="text-muted">Project archive</span>}
    </div>
  </div>
</article>
