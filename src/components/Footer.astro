---
import { Icon } from 'astro-icon/components';
import SocialIcons from './SocialIcons.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-page flex flex-col gap-8 py-10 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a href="#home" class="inline-flex items-center gap-2 font-display text-lg font-semibold text-fg transition-colors duration-100 hover:text-primary">
        <span class="grid size-7 place-items-center rounded-md bg-primary text-[0.625rem] font-bold text-on-accent">FJ</span>
        {profile.shortName}<span class="text-secondary">.</span>
      </a>
      <p class="mt-3 max-w-sm text-sm leading-6 text-muted">Building useful products, learning in public, and leaving systems a little clearer than I found them.</p>
      <p class="mt-4 text-xs text-muted">© {year} {profile.name}. Built with Astro.</p>
    </div>

    <div class="flex flex-col gap-4 sm:items-end">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium text-muted">
        <a href="#about" class="transition-colors duration-100 hover:text-primary">About</a>
        <a href="#projects" class="transition-colors duration-100 hover:text-primary">Work</a>
        <a href="/blog" class="inline-flex items-center gap-1 transition-colors duration-100 hover:text-primary">
          Blog
          <Icon name="lucide:arrow-up-right" width={13} height={13} aria-hidden="true" />
        </a>
        <a href="#contact" class="transition-colors duration-100 hover:text-primary">Contact</a>
      </div>
      <SocialIcons size={18} />
    </div>
  </div>
</footer>
