---
import { Icon } from 'astro-icon/components';
import { socialLinks } from '../data/profile';

interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className = '' } = Astro.props;
---

<ul class={`flex items-center gap-4 ${className}`}>
  {
    socialLinks.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="grid size-10 place-items-center rounded-full text-ink shadow-soft transition-transform duration-300 hover:-translate-y-1 hover:text-primary focus-visible:-translate-y-1 focus-visible:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
        >
          <Icon name={s.icon} width={size} height={size} />
        </a>
      </li>
    ))
  }
</ul>
