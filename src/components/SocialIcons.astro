---
import { Icon } from 'astro-icon/components';
import { socialLinks } from '../data/profile';

interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className = '' } = Astro.props;
---

<ul class={`flex items-center gap-2 ${className}`}>
  {
    socialLinks.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="grid size-10 place-items-center rounded-full border border-border bg-panel text-muted transition-[transform,border-color,color,background-color] duration-100 hover:-translate-y-1 hover:border-primary hover:bg-soft-primary hover:text-primary"
        >
          <Icon name={s.icon} width={size} height={size} />
        </a>
      </li>
    ))
  }
</ul>
