---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="scroll-mt-20">
  <div class="container-page py-20 md:py-32">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">Selected work</p>
        <h2 class="text-balance mt-4 font-display text-3xl font-semibold leading-tight text-fg sm:text-5xl">
          A few things I've helped bring to life.
        </h2>
      </div>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors duration-100 hover:text-primary-700"
      >
        Read the notes
        <Icon name="lucide:arrow-up-right" width={16} height={16} aria-hidden="true" />
      </a>
    </div>

    <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
      From CMS-driven company profiles to data visualisation and machine-learning experiments, each project starts with a real problem.
    </p>

    <div class="mt-10 grid gap-5 sm:mt-12 sm:gap-6 lg:grid-cols-12" data-reveal>
      {projects.map((project) => <ProjectCard project={project} featured={project.data.featured} />)}
    </div>
  </div>
</section>
