---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="projects" class="scroll-mt-24">
  <div class="container-page py-20 md:py-28">
    <h2 class="text-4xl font-extrabold text-ink sm:text-5xl">My Work</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      A selection of projects I've built — from CMS-driven company profiles to IoT and machine-learning experiments.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
