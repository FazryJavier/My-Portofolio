---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="projects" class="scroll-mt-24">
  <div class="container-page py-24 md:py-32">
    <p class="eyebrow">Work</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-fg sm:text-5xl">Selected projects</h2>
    <p class="mt-4 max-w-2xl text-muted">
      From CMS-driven company profiles to IoT and machine-learning experiments.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
