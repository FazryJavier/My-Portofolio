---
import { profile } from '../data/profile';
---

<section class="scroll-mt-24">
  <div class="container-page py-6">
    <div class="rounded-3xl bg-linear-to-r from-secondary to-primary px-8 py-12 text-center shadow-card" data-reveal>
      <h2 class="text-2xl font-bold text-white sm:text-3xl">I'm available for freelance work</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/85">
        Have a project in mind? Let's build something impactful together.
      </p>
      <a
        href={profile.social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex items-center gap-2 rounded-lg bg-white px-7 py-3 font-semibold text-secondary shadow-soft transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Hire Me
      </a>
    </div>
  </div>
</section>
