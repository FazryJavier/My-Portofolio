---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
---

<section class="scroll-mt-20">
  <div class="container-page py-8 md:py-12">
    <div
      class="relative isolate overflow-hidden rounded-[1.5rem] bg-primary px-6 py-14 shadow-card sm:px-12 sm:py-16"
      data-reveal
    >
      <div class="pointer-events-none absolute -right-20 -top-28 -z-10 size-80 rounded-full bg-primary-600/60 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 -z-10 size-64 rounded-full bg-secondary/35 blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-on-accent/70">Have a good problem?</p>
        <h2 class="text-balance mt-4 font-display text-3xl font-semibold leading-tight text-on-accent sm:text-4xl">
          Let's make the next useful thing.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-on-accent/80">
          I'm open to thoughtful freelance projects, product teams, and conversations about building better systems.
        </p>
        <a
          href={profile.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex h-12 items-center gap-2 rounded-lg bg-panel px-5 text-sm font-semibold text-primary shadow-soft transition-[transform,box-shadow] duration-100 hover:-translate-y-0.5 hover:shadow-card"
        >
          Start a conversation
          <Icon name="lucide:arrow-up-right" width={17} height={17} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
