---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
---

<section class="scroll-mt-24">
  <div class="container-page py-8">
    <div
      class="relative overflow-hidden rounded-3xl border border-border px-8 py-14 text-center shadow-card"
      style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent-2) 80%, var(--accent)))"
      data-reveal
    >
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Let's build something impactful
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-white/85">
        I'm available for freelance projects and full-time roles. Have an idea? Let's make it real.
      </p>
      <a
        href={profile.social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-7 py-3.5 font-semibold text-[#1a1d27] shadow-soft transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <Icon name="simple-icons:whatsapp" width={18} height={18} />
        Hire Me
      </a>
    </div>
  </div>
</section>
